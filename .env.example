# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Application ---------------------------------------------------------
APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:8501"]   # JSON list

# --- Security / Auth -----------------------------------------------------
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (PostgreSQL) -----------------------------------------------
DATABASE_URL=postgresql+psycopg://coachin:coachin@localhost:5432/coachin

# --- OpenAI --------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o                  # pick your preferred chat model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# --- Pinecone (RAG) ------------------------------------------------------
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=coachin-knowledge
PINECONE_NAMESPACE=default
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1                 # free plan supports aws/us-east-1
EMBEDDING_DIMENSIONS=1536                 # must match the embedding model

# --- Frontend ------------------------------------------------------------
BACKEND_URL=http://localhost:8000
